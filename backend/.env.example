# ===== W3EX Backend Configuration =====
# Copy to .env and adjust. All vars optional; defaults shown.

# --- Data providers ---
# market: rich (recommended: Binance + CoinGecko + mock fallback) | binance | coingecko | mock
W3EX_MARKET_PROVIDER=rich
# execution: rich (multi-route: Binance CEX + Jupiter DEX + Hyperliquid perp) | binance | jupiter | hyperliquid | mock
W3EX_EXECUTION_PROVIDER=rich

# --- Database ---
# Default: SQLite (zero-config). For Docker/Postgres:
# W3EX_DATABASE_URL=postgresql+asyncpg://w3ex:w3ex@localhost:5432/w3ex
# W3EX_DATABASE_URL=sqlite+aiosqlite:///./w3ex.db

# --- Redis (optional) ---
# W3EX_REDIS_URL=redis://localhost:6379/0

# --- Network (behind firewall/proxy) ---
# httpx auto-detects macOS system proxy; override explicitly if needed:
# W3EX_HTTPS_PROXY=http://127.0.0.1:7890

# --- Binance endpoint override (mirror if api.binance.com unreachable) ---
# W3EX_BINANCE_SPOT_BASE=https://data-api.binance.vision/api/v3
# W3EX_BINANCE_FAPI_BASE=https://fapi.binance.com/fapi/v1

# --- CORS ---
# W3EX_CORS_ORIGINS=http://localhost:3000,http://localhost:3002
